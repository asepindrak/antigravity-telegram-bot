# Antigravity Telegram Bot Configuration Template
# Copy this file to .env and fill in your values, or run: python setup.py

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Telegram User ID (single ID or comma-separated for multiple users, e.g. 123456789,987654321)
# Get your ID from @userinfobot on Telegram
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# 3. AGY OpenAI Bridge Configuration
AGY_BRIDGE_HOST=0.0.0.0
AGY_BRIDGE_PORT=8001
AGY_BRIDGE_API_KEY=

# 4. Default Project Name (default: general)
DEFAULT_PROJECT_NAME=general

# 5. PC Music Remote Control (ytmusic-api + YouTube Iframe)
MUSIC_FEATURE_ENABLED=true
MUSIC_AUTO_PLAY_PC=true
MUSIC_PLAYER_PORT=8002

# 6. Voice Note & Speech Settings
VOICE_REPLY_ENABLED=true
VOICE_NAME=id-ID-GadisNeural
VOICE_SPEED=+0%
# Optional: High-speed cloud Whisper transcription (fallback is free Google Speech Recognition)
GROQ_API_KEY=
OPENAI_API_KEY=
